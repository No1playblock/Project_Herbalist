  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 150b969e9cedbd24793397582e4c9e1e, type: 3}
  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::Herbalist.GameUI.StagePlaytestHud
  _overlay: {fileID: 7075082039134581294}
  _dialogueAction: {fileID: 11400000, guid: 3b653ec2bbde4a96839487e2be8cd8aa, type: 2}
  _historyPanel: {fileID: 6495544471107591499}
  _historyText: {fileID: 1096220397043220517}
  _historyScroll: {fileID: 530122404354820417}
  _spotlight: {fileID: 839208636312936983}
  _shade:
  - {fileID: 3578638411372618580}
  - {fileID: 8825113166552424765}
  - {fileID: 4184048511134690}
  - {fileID: 8124877342307060541}
  _guideFrame: {fileID: 3747085041864442295}
  _guideArrow: {fileID: 441911823272166009}
  _guideText: {fileID: 5928463011209572491}
  _recoveryFade: {fileID: 4556297986010209963}
  _guideSeconds: 3.5
  _recoverySeconds: 0.35
  _leafGuideRange: 12
  _guideHalfSize: {x: 0.075, y: 0.1}
  _emptyHistory: "\uC544\uC9C1 \uAE30\uB85D\uB41C \uB300\uC0AC\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
  _opening: "\uB450\uC601: \uBA3C\uC800 \uC8FC\uBCC0\uC5D0\uC11C \uC57D\uCD08\uB97C \uCC3E\uC544\uBCF4\uC790."
  _firstGather: "\uC18C\uB2F4: \uCCAB \uC57D\uCD08\uB97C \uCC3E\uC558\uAD70\uC694. \uC81C\uAC8C \uAC74\uB124\uC8FC\uC2DC\uBA74 \uC57D\uC81C\uB97C \uB9CC\uB4E4 \uC218 \uC788\uC5B4\uC694."
  _sodamLeafFall:
  - "\uC18C\uB2F4: \uC544\u2026 \uC81C\uAC00 \uBC1F\uC73C\uB2C8\uAE4C \uB098\uBB47\uC78E\uC774 \uD68C\uC218\uB418\uB294\uAD70\uC694. \uB450\uC601\uC774 \uAC74\uB108\uC57C\uACA0\uC5B4\uC694."
  - "\uB450\uC601: \uADF8\uB7FC \uC774\uBC88\uC5D4 \uB0B4\uAC00 \uBA3C\uC800 \uAC00\uBCFC\uAC8C!"
  _duyeongLeafFall:
  - "\uB450\uC601: \uC5B4? \uB0B4\uAC00 \uBC1F\uC73C\uB2C8\uAE4C \uB098\uBB47\uC78E\uC774 \uC0AC\uB77C\uC84C\uC5B4!"
  - "\uC18C\uB2F4: \uB098\uBB47\uC78E\uC744 \uC0AC\uC6A9\uD558\uB294 \uC0AC\uB78C\uC774 \uBC1F\uC73C\uBA74 \uD68C\uC218\uB418\uB294 \uBAA8\uC591\uC774\uC5D0\uC694. \uC774\uBC88\uC5D0\uB294 \uC81C\uAC00 \uAC74\uB108\uBCFC\uAC8C\uC694."
  _leafGuide: "\uC218\uC561 \uD754\uC801\uC5D0\uB294 \uB098\uBB47\uC78E\uC744 \uB358\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  _sapGuide: "\uB098\uBB34 \uD648\uC5D0\uB294 \uC218\uC561\uC744 \uC8FC\uC785\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
