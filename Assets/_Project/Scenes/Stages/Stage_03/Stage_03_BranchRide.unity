  _waitingText: "\uB450 \uBA85 \uBAA8\uB450 E\uB85C \uBD80\uC801\uC5D0 \uD0D1\uC2B9\uD558\uC138\uC694."
  _ridingText: "\uC218\uC561: \uACFC\uB141 \uC870\uC900 + R \xB7 \uC78E: \uACBD\uB85C \uC870\uC900 + R / \uC88C\uD074\uB9AD \uD68C\uC218 \xB7 \uB3CC\uC774 \uC9C0\uB098\uAC08 \uB54C\uAE4C\uC9C0 \uC815\uC9C0"
