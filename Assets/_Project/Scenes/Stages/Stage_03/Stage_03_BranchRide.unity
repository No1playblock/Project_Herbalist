  _turned: "\uB450\uC601: \uAC00\uC9C0\uAC00 \uC6C0\uC9C1\uC600\uC5B4. \uACFC\uB141\uC73C\uB85C \uAE38\uC744 \uBC14\uAFC0 \uC218 \uC788\uB098 \uBD10."
  _stone: "\uB450\uC601: \uC7A0\uAE50 \uBA48\uCD9C \uC218 \uC5C6\uC744\uAE4C?  \uC18C\uB2F4: \uB3CC\uC774 \uC9C0\uB098\uAC04 \uB4A4\uC5D0 \uC6C0\uC9C1\uC774\uB294 \uAC8C \uC88B\uACA0\uC5B4\uC694."
