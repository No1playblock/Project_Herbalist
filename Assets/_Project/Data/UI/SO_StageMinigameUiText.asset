  gatherDuyeongTitle: "\uC57D\uCD08 \uCC44\uC9D1 \xB7 \uB450\uC601"
  gatherDuyeongBody: "\uB208\uC55E\uC758 \uC57D\uCD08\uB97C \uAD00\uCC30\uD574 \uC18C\uB2F4\uC5D0\uAC8C \uD2B9\uC9D5\uC744 \uC54C\uB824\uC8FC\uC138\uC694.\n\uB3C4\uAC10\uC5D0\uC11C \uC54C\uB824\uC900 \uC21C\uC11C\uB300\uB85C W/A/S/D\uB97C \uB204\uB974\uC138\uC694.\n\uD55C \uBC88 \uD2C0\uB9AC\uBA74 \uB2E4\uC2DC \uCC44\uC9D1\uD574\uC57C \uD569\uB2C8\uB2E4."
  gatherProgressFormat: "\uCC44\uC9D1 {0} / 10"
  gatherSodamTitle: "\uC57D\uCD08 \uB3C4\uAC10 \xB7 \uC18C\uB2F4"
  gatherSodamIntro: "\uB450\uC601\uC774 \uC124\uBA85\uD558\uB294 \uC57D\uCD08\uB97C \uC544\uB798\uC5D0\uC11C \uCC3E\uC544 \uCC44\uC9D1 \uC21C\uC11C\uB97C \uC54C\uB824\uC8FC\uC138\uC694."
  codexStepsLabel: "\uC21C\uC11C:"
  gatherSodamProgress: "\uB450\uC601\uC5D0\uAC8C \uC21C\uC11C\uB97C \uC804\uB2EC\uD558\uC138\uC694"
  craftSodamTitle: "\uC57D\uC81C \uC81C\uC870 \xB7 \uC18C\uB2F4"
  craftSodamBodyFormat: "{0}\uC744(\uB97C) \uB2EC\uC774\uB294 \uC911\uC785\uB2C8\uB2E4.\n\uBAA9\uD45C \uC628\uB3C4: {1:0}\u2013{2:0}\xB0C\nSpace\uB97C \uB204\uB974\uACE0 \uC788\uC73C\uBA74 \uBD80\uCC44\uC9C8\uD569\uB2C8\uB2E4. \uB450\uC601\uC5D0\uAC8C \uD604\uC7AC \uC0C1\uD0DC\uB97C \uBB3C\uC5B4\uBCF4\uC138\uC694."
  craftSodamProgressFormat: "\uC801\uC815 \uC628\uB3C4 \uC720\uC9C0 {0:0.0} / {1:0.0}\uCD08   \xB7   \uB0A8\uC740 \uC2DC\uAC04 {2:0}\uCD08"
  craftDuyeongTitle: "\uC57D\uD0D5\uAE30 \uAD00\uCC30 \xB7 \uB450\uC601"
  craftDuyeongBodyFormat: "\uD604\uC7AC \uC57D\uD0D5\uAE30 \uC628\uB3C4: {0:0}\xB0C\n\uBD88 \uC138\uAE30: {1}\n\uC18C\uB2F4\uC5D0\uAC8C \uC628\uB3C4\uC640 \uBD88 \uC138\uAE30\uB97C \uC54C\uB824\uC8FC\uC138\uC694. \uBAA9\uD45C \uC628\uB3C4\uB294 \uC18C\uB2F4\uB9CC \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  craftDuyeongProgressFormat: "\uB0A8\uC740 \uC2DC\uAC04 {0:0}\uCD08"
  fireStrong: "\uAC15"
  fireWeak: "\uC57D"
  stepUp: W
  stepLeft: A
  stepDown: S
  stepRight: D
