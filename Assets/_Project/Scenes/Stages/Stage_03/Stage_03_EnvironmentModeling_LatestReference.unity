  _boardText: "\uBD80\uC801\uC5D0 \uD0D1\uC2B9\uD588\uC2B5\uB2C8\uB2E4. \uB450 \uBA85\uC774 \uD0D1\uC2B9\uD558\uBA74 \uCD9C\uBC1C\uD569\uB2C8\uB2E4."
  _waitingText: "\uB450 \uBA85 \uBAA8\uB450 E\uB85C \uBD80\uC801\uC5D0 \uD0D1\uC2B9\uD558\uC138\uC694."
  _ridingText: "\uC218\uC561: \uACFC\uB141 \uC870\uC900 + R \xB7 \uC78E: \uACBD\uB85C \uC870\uC900 + R / \uC88C\uD074\uB9AD \uD68C\uC218 \xB7 \uB3CC\uC774 \uC9C0\uB098\uAC08 \uB54C\uAE4C\uC9C0 \uC815\uC9C0"
  _blockedText: "\uB098\uBB47\uC78E \uC55E\uC5D0\uC11C \uC815\uC9C0 \xB7 \uD68C\uC218\uD558\uBA74 \uB2E4\uC2DC \uC774\uB3D9\uD569\uB2C8\uB2E4"
  _failedText: "\uCD94\uB77D \uB610\uB294 \uB3CC \uCDA9\uB3CC \xB7 \uC2DC\uC791 \uC9C0\uC810\uC5D0\uC11C \uB2E4\uC2DC \uD0D1\uC2B9\uD558\uC138\uC694"
  _completeText: "\uC11C\uB0AD\uB2F9 \uCD5C\uD558\uB2E8 \uB3C4\uCC29 \xB7 3\uC2A4\uD14C\uC774\uC9C0 \uC644\uB8CC"
