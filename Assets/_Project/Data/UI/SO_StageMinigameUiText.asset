  m_Name: SO_StageMinigameUiText
  m_EditorClassIdentifier: Assembly-CSharp::Herbalist.GameUI.StageMinigameUiText
  gatherDuyeongTitle: "\uC57D\uCD08 \uCC44\uC9D1 \xB7 \uB450\uC601"
  gatherDuyeongBody: "\uB208\uC55E\uC758 \uC57D\uCD08\uB97C \uAD00\uCC30\uD574 \uC18C\uB2F4\uC5D0\uAC8C \uD2B9\uC9D5\uC744 \uC54C\uB824\uC8FC\uC138\uC694.\n\uB3C4\uAC10\uC5D0\uC11C \uC54C\uB824\uC900 \uC21C\uC11C\uB300\uB85C W/A/S/D\uB97C \uB204\uB974\uC138\uC694.\n\uD55C \uBC88 \uD2C0\uB9AC\uBA74 \uB2E4\uC2DC \uCC44\uC9D1\uD574\uC57C \uD569\uB2C8\uB2E4."
  gatherProgressFormat: "\uCC44\uC9D1 {0} / 10"
  gatherSodamTitle: "\uC57D\uCD08 \uB3C4\uAC10 \xB7 \uC18C\uB2F4"
  gatherSodamIntro: "\uB450\uC601\uC758 \uC124\uBA85\uC744 \uB4E3\uACE0 \uC77C\uCE58\uD558\uB294 \uC57D\uCD08\uB97C \uACE0\uB974\uC138\uC694."
  codexStepsLabel: "\uC21C\uC11C:"
  gatherSodamProgress: "\uB450\uC601\uC5D0\uAC8C \uC21C\uC11C\uB97C \uC804\uB2EC\uD558\uC138\uC694"
  gatherDuyeongInputHint: "\uC57D\uCD08\uC758 \uC0DD\uAE40\uC0C8\uB97C \uC18C\uB2F4\uC5D0\uAC8C \uC124\uBA85\uD558\uACE0, \uB4E4\uC740 \uC21C\uC11C\uB300\uB85C W \xB7 A \xB7 S \xB7 D\uB97C \uB204\uB974\uC138\uC694."
  gatherCompleteText: "\uCC44\uC9D1\uC744 \uB9C8\uCCE4\uC2B5\uB2C8\uB2E4."
  craftSodamTitle: "\uC57D\uC81C \uC81C\uC870 \xB7 \uC18C\uB2F4"
  craftSodamBodyFormat: "{0} \uC81C\uC870 \uC911\n\uBAA9\uD45C \uC628\uB3C4: {1:0}~{2:0}\xB0C\nSpace\uB97C \uC9E7\uAC8C \uBC18\uBCF5\uD574\uC11C \uBD80\uCC44\uC9C8\uD558\uC138\uC694. \uB450\uC601\uC5D0\uAC8C \uD604\uC7AC \uC628\uB3C4\uC640 \uBD88 \uC138\uAE30\uB97C \uBB3C\uC5B4\uBCF4\uC138\uC694."
  craftSodamProgressFormat: "\uC81C\uC870 \uAC8C\uC774\uC9C0 {0:0}% / 100% \xB7 \uB0A8\uC740 \uC2DC\uAC04 {1:0}\uCD08"
  craftDuyeongTitle: "\uC57D\uD0D5\uAE30 \uAD00\uCC30 \xB7 \uB450\uC601"
  craftDuyeongBodyFormat: "\uD604\uC7AC \uC57D\uD0D5\uAE30 \uC628\uB3C4: {0:0}\xB0C\n\uBD88 \uC138\uAE30: {1} (\uCD5C\uADFC 1\uCD08 {2}\uD68C)\n\uC18C\uB2F4\uC5D0\uAC8C \uC628\uB3C4\uC640 \uBD88 \uC138\uAE30\uB97C \uC54C\uB824\uC8FC\uC138\uC694. \uBAA9\uD45C \uC628\uB3C4\uB294 \uC18C\uB2F4\uB9CC \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  craftDuyeongProgressFormat: "\uB0A8\uC740 \uC2DC\uAC04 {0:0}\uCD08"
  fireStrong: "\uAC15"
  fireMedium: "\uC911"
  fireWeak: "\uC57D"
  targetTemperatureTitle: "\uC801\uC815 \uC628\uB3C4 \uAD6C\uAC04"
  currentTemperatureTitle: "\uD604\uC7AC \uC57D\uD0D5\uAE30 \uC628\uB3C4"
  targetTemperatureFormat: "{0:0}~{1:0}\xB0C"
  currentTemperatureFormat: "{0:0}\xB0C"
  fireStrengthFormat: "\uBD88 \uC138\uAE30 \xB7 {0}"
  temperatureLow: "\uC628\uB3C4\uAC00 \uB0AE\uC544\uC694"
  temperatureInRange: "\uC801\uC815 \uC628\uB3C4"
  temperatureHigh: "\uC628\uB3C4\uAC00 \uB192\uC544\uC694"
  brewingGaugeFormat: "\uC81C\uC870 {0:0}%"
  brewingTimeFormat: "<b>{0:00}</b>\uCD08"
  fanPrompt: "<b>Space</b>  \uBD80\uCC44\uC9C8\uD558\uAE30"
