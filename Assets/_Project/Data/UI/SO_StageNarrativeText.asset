--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9e125a6a853d4a6cb805fed3ef63bfdc, type: 3}
  m_Name: SO_StageNarrativeText
  m_EditorClassIdentifier: Assembly-CSharp::Herbalist.GameUI.StageNarrativeText
  entries:
  - id: "M1-01"
    speaker: ""
    text: "\uc57d\uc81c\ub97c \ubcf5\uc6a9\ud574 \ub2a5\ub825\uc744 \ud68d\ub4dd\ud558\uc138\uc694. (0/2)"
  - id: "M1-02"
    speaker: ""
    text: "\uc218\uc561 \uc810\ud504\ub300\ub97c \uc791\ub3d9\uc2dc\ud0a4\uc138\uc694."
  - id: "M1-03"
    speaker: ""
    text: "\ub098\ubb34 \uaf2d\ub300\uae30\ub85c \uc62c\ub77c\uac00\uc138\uc694"
  - id: "M2-01"
    speaker: ""
    text: "\uc218\uc561 \ubbf8\ub85c\ub97c \ud574\uacb0\ud558\uc138\uc694 (0/3)"
  - id: "M3-01"
    speaker: ""
    text: "\ubd80\uc801\uc744 \ud0c0\uace0 \ub098\ubb34 \uc544\ub798\ub85c \ub0b4\ub824\uac00\uc138\uc694 (0/2)"
  - id: "M3-02"
    speaker: ""
    text: "\uc804\uc124\uc758 \uc57d\ucd08\ub97c \ucc44\uc9d1\ud558\uc138\uc694 (0/1)"
  - id: "S1-01"
    speaker: ""
    text: "\uc218\uc561 \uc57d\ucd08\ub97c \ucc3e\uc73c\uc138\uc694."
  - id: "S1-02"
    speaker: ""
    text: "\uc218\uc561 \uc57d\ucd08\ub97c \ucc44\uc9d1\ud558\uc138\uc694."
  - id: "S1-03"
    speaker: ""
    text: "\uc218\uc561 \uc57d\uc81c\ub97c \uc81c\uc870\ud558\uc138\uc694."
  - id: "S1-04"
    speaker: ""
    text: "\uc218\uc561 \uc57d\uc81c\ub97c \ubcf5\uc6a9\ud558\uc138\uc694."
  - id: "S1-05"
    speaker: ""
    text: "\ub098\ubb47\uc78e \uc57d\ucd08\ub97c \ucc3e\uc73c\uc138\uc694."
  - id: "S1-06"
    speaker: ""
    text: "\ub098\ubb47\uc78e \uc57d\ucd08\ub97c \ucc44\uc9d1\ud558\uc138\uc694."
  - id: "S1-07"
    speaker: ""
    text: "\ub098\ubb47\uc78e \uc57d\uc81c\ub97c \uc81c\uc870\ud558\uc138\uc694."
  - id: "S1-08"
    speaker: ""
    text: "\ub098\ubb47\uc78e \uc57d\uc81c\ub97c \ubcf5\uc6a9\ud558\uc138\uc694."
  - id: "S1-09"
    speaker: ""
    text: "\uc11c\ub0ad\ub2f9\uc73c\ub85c \uc774\ub3d9\ud558\uc138\uc694."
  - id: "S1-10"
    speaker: ""
    text: "\ubc84\uc12f \ud648\uc5d0 \ub098\ubb47\uc78e\uc744 \uc124\uce58\ud558\uc138\uc694."
  - id: "S1-11"
    speaker: ""
    text: "\ub098\ubb34 \ud648\uc5d0 \uc218\uc561\uc744 \uc8fc\uc785\ud558\uc138\uc694."
  - id: "S2-01"
    speaker: ""
    text: "\uccab \ubc88\uc9f8 \uc218\uc561 \ubbf8\ub85c\ub97c \ud574\uacb0\ud558\uc138\uc694."
  - id: "S2-02"
    speaker: ""
    text: "\ub450 \ubc88\uc9f8 \uc218\uc561 \ubbf8\ub85c\ub97c \ud574\uacb0\ud558\uc138\uc694."
  - id: "S2-03"
    speaker: ""
    text: "\uc138 \ubc88\uc9f8 \uc218\uc561 \ubbf8\ub85c\ub97c \ud574\uacb0\ud558\uc138\uc694."
  - id: "S3-01"
    speaker: ""
    text: "\ubd80\uc801\uc5d0 \ud0d1\uc2b9\ud558\uc138\uc694."
  - id: "T1-01"
    speaker: ""
    text: "\ub098\ubb34 \ud648\uc5d0\ub294 \uc218\uc561\uc744 \uc8fc\uc785\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
  - id: "T1-02"
    speaker: ""
    text: "\uc218\uc561 \ud754\uc801\uc5d0\ub294 \ub098\ubb47\uc78e\uc744 \ub358\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
  - id: "T1-03"
    speaker: ""
    text: "\uac00\uc9c0\uc5d0 \ubd99\uc778 \ub098\ubb47\uc78e\uc740 \uc218\uc561 \ub2a5\ub825\uc790\ub9cc \ud0c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
  - id: "T1-04"
    speaker: ""
    text: "\ucc9c \ub05d\uc758 \ub9e4\ub4ed\uc744 \uc7a1\uace0 \uc774\ub3d9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
  - id: "T2-01"
    speaker: ""
    text: "\ubbf8\ub85c\uc758 \ud648\uc744 \ub530\ub77c \uc218\uc561\uc744 \uc774\ub3d9\uc2dc\ud0a4\uc138\uc694."
  - id: "T2-02"
    speaker: ""
    text: "\ubbf8\ub85c\ud310\uc758 \ub204\uc218 \uad6c\uba4d\uc740 \ub098\ubb47\uc78e\uc73c\ub85c \ub9c9\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
  - id: "T2-03"
    speaker: ""
    text: "\uc218\uc561 \ubc29\uc6b8\uc744 \ubaa8\uc73c\uba74 \uc218\uc561\ub7c9\uc774 \ub298\uc5b4\ub0a9\ub2c8\ub2e4."
  - id: "T2-04"
    speaker: ""
    text: "\ud604\uc7ac \uc218\uc561\ub7c9\uacfc \ubaa9\ud45c \uc218\uc561\ub7c9\uc744 \ud655\uc778\ud574 \uc0c1\ub300\uc5d0\uac8c \uc54c\ub824\uc8fc\uc138\uc694."
  - id: "T3-01"
    speaker: ""
    text: "\ub450 \ud50c\ub808\uc774\uc5b4\uac00 \ubaa8\ub450 \uc62c\ub77c\uac00\uba74 \ubd80\uc801\uc774 \uc6c0\uc9c1\uc785\ub2c8\ub2e4."
  - id: "T3-02"
    speaker: ""
    text: "\uacfc\ub141\uc5d0 \uc218\uc561\uc744 \ub9de\ud788\uba74 \uc5f0\uacb0\ub41c \ub098\ubb47\uac00\uc9c0\uac00 \uc6c0\uc9c1\uc785\ub2c8\ub2e4."
  - id: "T3-03"
    speaker: ""
    text: "\uad74\ub7ec\uc624\ub294 \ub3cc\uc740 \ub098\ubb47\uc78e\uc744 \ub358\uc838 \ud30c\uad34\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
  - id: "D-001"
    speaker: "\ub450\uc601"
    text: "\uc640, \uc774\uac8c \uc11c\ub0ad\ub2f9\uc774\uad6c\ub098. \uac00\uae4c\uc774\uc11c \ubcf4\ub2c8\uae4c \ud6e8\uc52c \ud06c\ub124!"
  - id: "D-002"
    speaker: "\uc18c\ub2f4"
    text: "\uc804\uc124\uc758 \uc57d\ucd08\uac00 \uc790\ub780\ub2e4\ub294 \uacf3\uc774\uc796\uc544\uc694. \uc6b0\uc120 \uc8fc\ubcc0\ubd80\ud130 \uc0b4\ud3b4\ubd10\uc694."
  - id: "D-003"
    speaker: "\ub450\uc601"
    text: "\ucc98\uc74c \ubcf4\ub294 \uc57d\ucd08\uc778\ub370. \uc77c\ub2e8 \ucc59\uaca8\ubcf4\uc790."
  - id: "D-004"
    speaker: "\uc18c\ub2f4"
    text: "\uc7a0\uae50\uc694. \ubfcc\ub9ac\uac00 \uc0c1\ud558\uc9c0 \uc54a\ub3c4\ub85d \uc870\uc2ec\ud574\uc11c \ucc44\uc9d1\ud574 \uc8fc\uc138\uc694."
  - id: "D-005"
    speaker: "\uc18c\ub2f4"
    text: "\uc88b\uc544\uc694. \uc0dd\uac01\ud588\ub358 \ub300\ub85c \uc798 \ub9cc\ub4e4\uc5b4\uc84c\uc5b4\uc694."
  - id: "D-006"
    speaker: "\ub450\uc601"
    text: "\uc5ed\uc2dc \uc18c\ub2f4\uc774\ub124. \uc57d \ub9cc\ub4dc\ub294 \uac74 \ub108\ud55c\ud14c \ub9e1\uae38\uac8c."
  - id: "D-007"
    speaker: "\ub450\uc601"
    text: "\uc774\uc81c \ub2a5\ub825\ub3c4 \uc0dd\uacbc\uc73c\ub2c8 \uc704\ub85c \uc62c\ub77c\uac00 \ubcf4\uc790!"
  - id: "D-008"
    speaker: "\uc18c\ub2f4"
    text: "\uc88b\uc544\uc694. \ucc98\uc74c \uc4f0\ub294 \ud798\uc774\ub2c8\uae4c \uc870\uc2ec\ud558\uace0\uc694."
  - id: "D-009"
    speaker: "\ub450\uc601"
    text: "\uc774 \uad6c\uba4d\ub4e4, \uc11c\ub85c \uc774\uc5b4\uc838 \uc788\ub294 \uac83 \uac19\uc740\ub370?"
  - id: "D-010"
    speaker: "\ub450\uc601"
    text: "\ub410\ub2e4! \uc774\uac78 \uc774\uc6a9\ud558\uba74 \ub354 \ub192\uc774 \uc62c\ub77c\uac08 \uc218 \uc788\uaca0\uc5b4!"
  - id: "D-011"
    speaker: "\ub450\uc601"
    text: "\ucc9c \ub05d\uc5d0 \ub9e4\ub4ed\uc774 \uc788\ub124. \uc7a1\uace0 \uc6c0\uc9c1\uc77c \uc218 \uc788\uaca0\uc5b4."
  - id: "D-012"
    speaker: "\uc18c\ub2f4"
    text: "\ucc9c \ub05d\uc5d0 \ub9e4\ub4ed\uc774 \uc788\ub124\uc694. \uc81c\uac00 \uc7a1\uc544\ubcfc\uac8c\uc694."
  - id: "D-013"
    speaker: "\ub450\uc601"
    text: "\ub4dc\ub514\uc5b4 \uaf2d\ub300\uae30\ub2e4! \uc0dd\uac01\ubcf4\ub2e4 \ud6e8\uc52c \ub192\uc558\ub124."
  - id: "D-014"
    speaker: "\ub450\uc601"
    text: "\uc55e\ub4a4\uac00 \ub2e4\ub978 \ud310\uc790\ub124. \uc774\uac78\ub85c \uc5b4\ub5bb\uac8c \ub0b4\ub824\uac00\uc9c0?"
  - id: "D-015"
    speaker: "\uc18c\ub2f4"
    text: "\uc11c\ub85c \ubcf4\uc774\ub294 \uac78 \uc54c\ub824\uc8fc\uba74\uc11c \ud480\uc5b4\ubd10\uc694."
  - id: "D-016"
    speaker: "\uc18c\ub2f4"
    text: "\uc7a0\uae50\ub9cc\uc694, \uc774\ucabd\uc5d0\uc11c \uc218\uc561\uc774 \uc0c8\uace0 \uc788\uc5b4\uc694!"
  - id: "D-018"
    speaker: "\ub450\uc601"
    text: "\uc5b4? \uc5ec\uae30 \uad6c\uba4d\uc5d0\uc11c \uc218\uc561\uc774 \uc0c8\ub294\ub370?"
  - id: "D-020"
    speaker: "\ub450\uc601"
    text: "\ub3c4\ucc29\ud588\ub294\ub370\ub3c4 \ubc18\uc751\uc774 \uc5c6\ub124?"
  - id: "D-021"
    speaker: "\uc18c\ub2f4"
    text: "\uc218\uc561\uc774 \ubd80\uc871\ud574\uc694. \ub0a8\uc740 \ubc29\uc6b8\uc744 \ubaa8\uc544\uc11c \ub2e4\uc2dc \uc640\ubd10\uc694."
  - id: "D-022"
    speaker: "\uc18c\ub2f4"
    text: "\ub3c4\ucc29\ud588\ub294\ub370\ub3c4 \ubc18\uc751\uc774 \uc5c6\ub124\uc694."
  - id: "D-023"
    speaker: "\ub450\uc601"
    text: "\uc774\ucabd\uc5d0 \ud45c\uc2dc\ub41c \uc218\uc561\uc774 \ubd80\uc871\ud574! \uc870\uae08 \ub354 \ubaa8\uc544\ubcf4\uc790."
  - id: "D-041"
    speaker: "\ub450\uc601"
    text: "\ub0a8\uc740 \uc218\uc561\uc73c\ub85c \ud574\uacb0\ud560 \uc218\uac00 \uc5c6\uc5b4. \ub2e4\uc2dc \ud574\ubcf4\uc790!"
  - id: "D-042"
    speaker: "\uc18c\ub2f4"
    text: "\ub354 \ubaa8\uc744 \uc218\uc561\uc774 \uc5c6\uc5b4\uc694. \ub2e4\uc2dc \ud574\ubcf4\uc8e0?"
  - id: "D-024"
    speaker: "\ub450\uc601"
    text: "\ud574\ub0c8\ub2e4! \uc138 \uac1c \uc804\ubd80 \ub05d\ub0ac\uc5b4!"
  - id: "D-025"
    speaker: "\ub450\uc601"
    text: "\uc774\uac78 \ud0c0\uace0 \ub0b4\ub824\uac00\ub294 \uac70\uc57c? \ubd80\uc801\uce58\uace0\ub294 \uc5c4\uccad \ud070\ub370?"
  - id: "D-026"
    speaker: "\uc18c\ub2f4"
    text: "\ub450 \uc0ac\ub78c\uc774 \ud0c8 \ub9cc\ud07c \ud06c\ub124\uc694. \uc77c\ub2e8 \ud0c0\ubd10\uc694."
  - id: "D-027"
    speaker: "\uc18c\ub2f4"
    text: "\uc800 \uacfc\ub141, \uac00\uc9c0\ub791 \uc774\uc5b4\uc838 \uc788\ub294 \uac83 \uac19\uc740\ub370\uc694?"
  - id: "D-028"
    speaker: "\ub450\uc601"
    text: "\uc218\uc561\uc73c\ub85c \ud55c\ubc88 \ub9de\ud600\ubcf4\uc790."
  - id: "D-029"
    speaker: "\ub450\uc601"
    text: "\ub3cc\uc774 \uacc4\uc18d \uad74\ub7ec\uc624\uc796\uc544! \uc774\uac70 \uc5b4\ub5bb\uac8c \uc9c0\ub098\uac00\uc9c0?"
  - id: "D-030"
    speaker: "\uc18c\ub2f4"
    text: "\ub098\ubb47\uc78e\uc73c\ub85c \ub3cc\uc744 \ubd80\uc220 \uc218 \uc788\uc744\uc9c0\ub3c4 \ubaa8\ub974\uaca0\uc5b4\uc694."
  - id: "D-037"
    speaker: "\ub450\uc601"
    text: "\uc870\uae08 \ub354 \uac00\uae4c\uc774 \uac00\uc57c\uaca0\uc5b4."
  - id: "D-038"
    speaker: "\ub450\uc601"
    text: "\uc5ec\uae30\uc11c\ub294 \ub108\ubb34 \uba40\uc5b4."
  - id: "D-039"
    speaker: "\uc18c\ub2f4"
    text: "\uc870\uae08 \ub354 \uac00\uae4c\uc774 \uac00\uc57c\uaca0\uc5b4\uc694."
  - id: "D-040"
    speaker: "\uc18c\ub2f4"
    text: "\uc5ec\uae30\uc11c\ub294 \ub108\ubb34 \uba3c \uac83 \uac19\uc544\uc694."
